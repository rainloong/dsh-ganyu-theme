{
  "name": "dsh-theme-ganyu",
  "version": "1.0.0",
  "private": true,
  "description": "Ganyu-inspired frost-blue Web GUI theme for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node build.cjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
